# Targeting for slurm/monitor_run.sh. Copy, edit, then:
#     set -a; . slurm/monitor.env; set +a; bash slurm/monitor_run.sh

RAGTIME_ARTIFACT_ROOT=/scratch/<user>/ragtime-runs
RAGTIME_VLLM_REGISTRY=/scratch/<user>/ragtime-runs/serving/vllm_endpoints

# The e2e family: three reading arms, one queue each.
QUEUE=/scratch/<user>/ragtime-runs/corpus/e2e/<chunker-hash>/corpus-preprocess/queue
ARMS="original omt omt_opus"
CELLDIR_original=e2e-original__original__seed0
CELLDIR_omt=e2e-omt__omt__seed0
CELLDIR_omt_opus=e2e-omt-weak__omt_opus__seed0
TOTAL_CELLS=309

# The mlir family has one queue: the stage name comes from passage_lang, which is `original` for
# all three search arms, while the cell directory carries the searched index.
#   QUEUE=/scratch/<user>/ragtime-runs/corpus/mlir/<chunker-hash>/corpus-preprocess/queue
#   ARMS=original
#   CELLDIR_original=mlir-omt__original__seed0
#   TOTAL_CELLS=103
